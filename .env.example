# Layer 1 fact extraction and Layer 3 translation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Layer 3 world building, story generation, and voice inference
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Layer 3 narration
ELEVENLABS_API_KEY=
ELEVENLABS_FALLBACK_VOICE_ID=

# Service addresses; these are the defaults
LAYER2_BASE_URL=http://localhost:8000
WORLD_BUILDER_URL=http://localhost:8001
BLUEPRINT_URL=http://localhost:8002
STORY_GEN_URL=http://localhost:8003
TRANSLATOR_URL=http://localhost:8004
AUDIO_URL=http://localhost:8005

# Layer 3 artefact directories; these are the defaults
WORLD_BIBLE_DIR=./world_bible
BLUEPRINT_DIR=./blueprints
EPISODE_DIR=./episodes
AUDIO_DIR=./audio
RUN_HISTORY_DIR=./runs

# LLM and audio generation run far longer than ordinary HTTP handlers
DOWNSTREAM_TIMEOUT_SECONDS=180
